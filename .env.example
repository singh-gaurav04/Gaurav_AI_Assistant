APP_ENV=development
APP_NAME=Portfolio CMS API
# Local Docker Compose (host must be "db", not localhost):
# DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@db:5432/portfolio
#
# Supabase: use the Session pooler (IPv4), NOT the direct db.*.supabase.co URL.
# Direct hosts are IPv6-only and cause: OSError [Errno 101] Network is unreachable
# Dashboard → Connect → Session pooler (port 5432):
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@db:5432/portfolio
# auto = encrypt for remote (sslmode=require); off for localhost/docker
# require | disable | verify-full
DATABASE_SSL=auto
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Email (required for automatic notifications)
EMAIL_PROVIDER=smtp
EMAIL_FROM=your@gmail.com
ADMIN_EMAIL=your@gmail.com
ADMIN_PASSWORD=change-me-after-first-login
ADMIN_NAME=Admin
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_WIDTH=2400
MAX_IMAGE_HEIGHT=2400
IMAGE_QUALITY=85
# Chatbot (LangChain). Set keys for providers you enable in Admin → Chatbot.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_EMBEDDING_DIMENSION=1024
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-workshop
# Reuse an existing 1024-dim index if you hit Pinecone's free-tier index limit.
# Data is isolated via PINECONE_NAMESPACE below.
PINECONE_NAMESPACE=chatbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENROUTER_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_STORAGE_DIR=storage/chatbot
CHATBOT_MAX_FILE_MB=25
CHATBOT_CHUNK_SIZE=800
CHATBOT_CHUNK_OVERLAP=120
CHATBOT_TOP_K=5
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_HISTORY_TURNS=8
